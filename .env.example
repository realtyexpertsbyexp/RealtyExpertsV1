# Server & Environment Configuration
PORT=3000
NODE_ENV=development
SITE_URL=https://www.realtyexperts.online

# Lead Storage & Notification Strategy
# Options: 'file' (local durable storage in data/leads.json) or 'smtp' (with file backup)
LEAD_STORAGE_MODE=file

# SMTP Notification Credentials (optional - leave empty to log leads safely without sending SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LEADS_TO_EMAIL=connect@realtyexperts.online
LEADS_FROM_EMAIL=noreply@realtyexperts.online

# Public Analytics Identifiers (Optional, leave blank if not yet configured)
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
VITE_META_PIXEL_ID=
